# Port du serveur
PORT=5000

# Configuration PostgreSQL
DB_NAME=medconnect
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Clé secrète pour JWT
JWT_SECRET=your_jwt_secret_key_here

# Code administrateur pour créer des comptes admin
ADMIN_CODE=admin_secret_code_here

# URL du frontend (pour CORS)
CLIENT_URL=http://localhost:5173

# Envoi d'emails (SMTP) — ex. Gmail avec un "mot de passe d'application"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre_adresse@gmail.com
EMAIL_PASS=votre_mot_de_passe_application

# Sessions
# Durée du jeton d'accès (format jsonwebtoken : 15m, 1h...) et du cookie de rafraîchissement (jours)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
# lax si frontend et API sont sur le même site (ex. localhost:5173 et localhost:5000).
# none si ce sont deux domaines différents en production (le cookie devient alors Secure → HTTPS obligatoire).
COOKIE_SAMESITE=lax
# Tentatives de connexion autorisées par IP et par 15 minutes
AUTH_RATE_LIMIT=10

# Journal d'accès aux dossiers médicaux : durée de conservation en jours.
# Vide ou 0 = conservation illimitée (vérifiez la durée légale applicable).
JOURNAL_RETENTION_JOURS=

# Migrations de la base (voir migrations/README.md).
# true (défaut) : le serveur applique les migrations en attente au démarrage.
# false : il refuse de démarrer s'il en reste ; lancez « npm run migrate » vous-même.
MIGRATIONS_AUTO=true

# Derrière un proxy (nginx, hébergeur) : nombre de proxys de confiance, pour lire la vraie IP
# des visiteurs. Laisser vide si l'API est appelée directement (développement).
TRUST_PROXY=
# Cookie de session Secure : true | false | auto (Secure si la requête arrive en HTTPS).
# Vide : Secure en production uniquement.
COOKIE_SECURE=
# Sans SMTP, afficher les liens des emails dans les logs même en production (essai local)
EMAIL_LIENS_DANS_LOGS=false
