# Configuration de MedConnect pour Docker.
# Copiez ce fichier en « .env » (à côté de docker-compose.yml) et remplissez les valeurs.
# Le fichier .env ne doit jamais être commité (il est dans .gitignore).

# ── Obligatoire ──────────────────────────────────────────────
# Mot de passe de la base PostgreSQL (créée au premier lancement)
DB_PASSWORD=
# Secret de signature des sessions : longue chaîne aléatoire, ex. : openssl rand -hex 32
JWT_SECRET=
# Code demandé pour créer le premier compte administrateur (page /create-admin)
ADMIN_CODE=

# ── Adresse du site ─────────────────────────────────────────
# Port de votre machine sur lequel le site est servi
HTTP_PORT=8080
# Adresse publique du site, utilisée dans les liens des emails
CLIENT_URL=http://localhost:8080

# ── Emails (SMTP) ───────────────────────────────────────────
# Sans SMTP, aucun email n'est envoyé ; l'inscription exige pourtant de confirmer l'email.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Essai local sans SMTP : afficher les liens (vérification, mot de passe oublié) dans les
# logs → docker compose logs backend. Sans effet quand EMAIL_USER/EMAIL_PASS sont remplis.
EMAIL_LIENS_DANS_LOGS=true

# ── Facultatif ──────────────────────────────────────────────
# DB_NAME=medconnect
# DB_USER=medconnect
# Notifications push (générer avec : npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:contact@exemple.sn
# Durée de conservation du journal d'accès aux dossiers (jours ; vide = illimitée)
# JOURNAL_RETENTION_JOURS=
# Un autre proxy HTTPS devant (Caddy, Traefik, hébergeur…) → 2 proxys de confiance
# TRUST_PROXY=2
